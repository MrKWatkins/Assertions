<Project>
    <PropertyGroup>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
        <EnablePackageVersionOverride>false</EnablePackageVersionOverride>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0"/>
        <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.403"/>
        <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0"/>
        <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.2" />
        <PackageVersion Include="TUnit" Version="1.76.28"/>
    </ItemGroup>
</Project>